{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "env": {
    "IONMC_EXPERIMENT_ID": "experiment-v2",
    "IONMC_V2_EVENT_DIR": "~/.local/share/ionmc-experiment/experiment-v2/telemetry",
    "IONMC_TELEMETRY_DIR": "~/.local/share/ionmc-experiment/experiment-v2/telemetry",
    "IONMC_CODEX_RAW_DIR": "~/.local/share/ionmc-experiment/experiment-v2/raw/codex",
    "IONMC_VALIDATION_DIR": "~/.local/share/ionmc-experiment/experiment-v2/validation"
  },
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "python3 -m infrastructure.experiment_v2.notify",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "python3 -m infrastructure.experiment_v2.notify",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 -m infrastructure.experiment_v2.policy",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/log_event.py",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "/home/wahln/aiprojects/ion-mc-worktrees"
    ],
    "allow": [
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(decisions/**)",
      "Edit(validation/**)",
      "Edit(benchmarks/**)",
      "Edit(reference_requests/**)",
      "Edit(docs/**)",
      "Edit(infrastructure/**)",
      "Edit(.github/**)",
      "Edit(README.md)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(EXPERIMENT.md)",
      "Edit(REQUIREMENTS.md)",
      "Edit(pyproject.toml)",
      "Edit(uv.lock)",
      "Edit(.pre-commit-config.yaml)",
      "Bash(git *)",
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(pre-commit *)",
      "mcp__codex-worker",
      "mcp__task-manager",
      "mcp__human-intervention",
      "mcp__task-integration",
      "mcp__validation-manager",
      "mcp__task-commit",
      "mcp__host-runner",
      "mcp__v2-research",
      "mcp__v2-release",
      "Edit(experiment/v2/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)"
    ],
    "blockReadsOutsideWorkingDirectories": false,
    "defaultMode": "auto",
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/**)",
      "Read(~/.claude-ionmc/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(/mnt/c/Users/**)",
      "Bash(gh *)",
      "Read(//home/wahln/aiprojects/ion-mc-v1)",
      "Read(//home/wahln/aiprojects/ion-mc-v1/**)",
      "Read(//home/wahln/aiprojects/ion-mc-v1-worktrees)",
      "Read(//home/wahln/aiprojects/ion-mc-v1-worktrees/**)",
      "Read(//home/wahln/aiprojects/ion-mc-v2-before-isolation)",
      "Read(//home/wahln/aiprojects/ion-mc-v2-before-isolation/**)",
      "Read(//home/wahln/aiprojects/ion-mc-independent-audit-3a2e895)",
      "Read(//home/wahln/aiprojects/ion-mc-independent-audit-3a2e895/**)",
      "Read(//home/wahln/aiprojects/ion-mc-independent-audit-3a2e895.tar.gz)",
      "Read(//home/wahln/aiprojects/ion-mc-independent-audit-3a2e895.tar.gz/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "credentials": {
      "envVars": [
        {
          "mode": "deny",
          "name": "OPENAI_API_KEY"
        },
        {
          "mode": "deny",
          "name": "ANTHROPIC_API_KEY"
        },
        {
          "mode": "deny",
          "name": "GITHUB_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GH_TOKEN"
        },
        {
          "mode": "deny",
          "name": "AWS_ACCESS_KEY_ID"
        },
        {
          "mode": "deny",
          "name": "AWS_SECRET_ACCESS_KEY"
        },
        {
          "mode": "deny",
          "name": "AWS_SESSION_TOKEN"
        }
      ],
      "files": [
        {
          "mode": "deny",
          "path": "~/.ssh"
        },
        {
          "mode": "deny",
          "path": "~/.aws"
        },
        {
          "mode": "deny",
          "path": "~/.netrc"
        },
        {
          "mode": "deny",
          "path": "~/.docker/config.json"
        },
        {
          "mode": "deny",
          "path": "~/.config/gh/hosts.yml"
        }
      ]
    },
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "allowRead": [
        ".",
        "~/.local/bin",
        "~/.cache/ionmc-experiment/experiment-v2",
        "/home/wahln/aiprojects/ion-mc-worktrees",
        "~/.local/share/ionmc-experiment/experiment-v2/telemetry",
        "/home/wahln/aiprojects/ion-mc/.git",
        "~/.local/share/ionmc-experiment/experiment-v2/tmp",
        "~/.local/share/ionmc-experiment/experiment-v2/claude-memory"
      ],
      "allowWrite": [
        ".",
        "~/.cache/ionmc-experiment/experiment-v2",
        "/home/wahln/aiprojects/ion-mc-worktrees",
        "~/.local/share/ionmc-experiment/experiment-v2/telemetry",
        "~/.local/share/ionmc-experiment/experiment-v2/tmp",
        "~/.local/share/ionmc-experiment/experiment-v2/claude-memory"
      ],
      "denyRead": [
        "~/",
        "/home/wahln/aiprojects/ion-mc-v1",
        "/home/wahln/aiprojects/ion-mc-v1-worktrees",
        "/home/wahln/aiprojects/ion-mc-v2-before-isolation",
        "/home/wahln/aiprojects/ion-mc-independent-audit-3a2e895",
        "/home/wahln/aiprojects/ion-mc-independent-audit-3a2e895.tar.gz"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "autoMemoryDirectory": "~/.local/share/ionmc-experiment/experiment-v2/claude-memory"
}
